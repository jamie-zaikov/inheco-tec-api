# inheco-tec-api environment template.
#
# Every environment variable the API reads, each with an empty value. An empty value counts as
# unset. Copy only the lines you need into the service.env file that the manifest key
# service.env_file names (keep that file readable by the service account and administrators
# only). Never commit a filled-in copy.

# Bearer token that n8n sends; the manifest key auth.bearer_token_ref names this variable.
# Required: the service does not start without it. Use 32 or more random characters A-Z a-z 0-9 - _.
INHECO_TEC_API_TOKEN=

# Log level name (DEBUG, INFO, WARNING, ERROR, CRITICAL). Empty: INFO.
LOG_LEVEL=

# Path of the instrument manifest. Empty: instrument.yaml at the repository root.
INHECO_TEC_MANIFEST=

# Transport override, hidapi or fake. Empty: transport.kind of the manifest. Leave it empty on a
# host with hardware: fake drives no device.
INHECO_TEC_TRANSPORT=
